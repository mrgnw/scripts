#!/bin/sh
# Put the latest main live for a self-hosted app that pitchfork runs: pull, install, build, restart.
# Run from the app's main checkout, normally as its `pnpm ship`. The pitchfork daemon id is the argument.
set -eu
daemon=${1:?usage: ship-pitchfork <pitchfork daemon id, e.g. global/social>}

test "$(git branch --show-current)" = main || { echo "ship from main only" >&2; exit 1; }
test -z "$(git status --porcelain --untracked-files=no)" || { echo "working tree not clean" >&2; exit 1; }
git pull --ff-only origin main
test -z "$(git log --oneline '@{u}..HEAD')" || { echo "unpushed commits on main" >&2; exit 1; }
pnpm install --frozen-lockfile
pnpm build
pitchfork restart "$daemon"
echo "live: $(git log --oneline -1)"
git status -sb
